@startuml
!pragma layout smetana
title BrewLite A2 - Deployment production
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 35

node "Thiết bị người dùng" as Browser <<device>> {
  artifact "Trình duyệt" as Client
  }
frame "LOCAL" {
  node "Máy phát triển" as Dev <<device>>
}
frame "CI / BUILD" {
  node "GitHub Actions" as CI {
    artifact "PR CI và Railway CD" as Workflows
  }
  node "Registry Railway" as Registry
}
frame "PRODUCTION - Railway / brewlite-a2 / a2-production / sfo" {
  node "Railway HTTPS Edge" as Edge
  node "web" as Web <<container>> {
    artifact "Next.js standalone :3000\n/health" as Next
  }
  node "api" as API <<container>> {
    artifact "NestJS :3001\n/api/v1/health" as Nest
    artifact "Prisma migrate deploy" as Prisma
  }
  database "postgres\npostgres:18.4-alpine3.23 :5432" as DB
  storage "postgres-data (500 MB)\n/var/lib/postgresql" as Volume
  artifact "Biến môi trường, secrets\nHealth probes và runtime logs" as Ops
}
cloud "VNPay\nkhi được cấu hình" as VN

Dev --> CI : Git push
CI ..> Web : Railway CD
CI ..> API : Railway CD
Registry ..> Web : image nền tảng
Registry ..> API : image nền tảng
Browser --> Edge : HTTPS :443
Edge --> Web : web-a2-production
Edge --> API : api-a2-production
API --> DB : TCP :5432 private
DB -- Volume
Ops ..> Web
Ops ..> API
Browser ..> VN : redirect HTTPS
VN ..> Edge : IPN HTTPS
legend bottom
  Web và API lấy nguồn BrewLite_A2/main, dùng Dockerfile.railway tương ứng.
  Deployment quan sát ngày 10/11/2026 tại 2d868b6. CI/CD và smoke được truy vết riêng.
endlegend
@enduml
