@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam ArrowColor #655A50
skinparam actorBorderColor #493B31
skinparam actorFontColor #332B25
skinparam usecase {
  BackgroundColor #FFF9EE
  BorderColor #8B6749
  FontColor #332B25
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #53717A
  FontColor #334C55
}
title BrewLite - Use-case tổng quát MVP

actor "Khách hàng\n(chưa / đã đăng nhập)" as Customer

rectangle "BrewLite - ranh giới hệ thống" {
  usecase "UC-01\nĐăng ký tài khoản\nFR-05" as UC01
  usecase "UC-02\nĐăng nhập\nFR-05" as UC02
  usecase "UC-03\nXem menu\nFR-01" as UC03
  usecase "UC-04\nXem chi tiết và chọn\nsize / topping / đường / đá / note\nFR-02, FR-03" as UC04
  usecase "UC-05\nQuản lý giỏ hàng\nFR-04" as UC05
  usecase "UC-06\nĐặt đơn hàng\nFR-06" as UC06
  usecase "UC-07\nÁp dụng coupon\nFR-10" as UC07
  usecase "UC-08\nThực hiện thanh toán\nFR-07, FR-10" as UC08
  usecase "UC-09\nXem xác nhận, chi tiết\nvà lịch sử đơn hàng\nFR-08" as UC09
  usecase "UC-10\nCập nhật trạng thái / hủy đơn\nFR-09" as UC10
}

actor "Nhân viên quầy\nBARISTA" as Barista
actor "Mock Payment\nGateway" as Gateway

Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC09
Customer -- UC10
UC02 -- Barista
UC10 -- Barista
UC08 -- Gateway

UC04 .[norank].> UC03 : <<extend>>\n[mở chi tiết từ menu]
UC07 .[norank].> UC06 : <<extend>>\n[có coupon]

legend bottom
  MVP: UC-01..10; hai role tài khoản CUSTOMER / BARISTA.
  Quản lý / giảng viên / nhóm phát triển là stakeholder, không phải actor MVP.
  Gateway là dịch vụ cộng tác logic, không phải role; không thu tiền thật.
  Đặt / thanh toán / đọc / hủy đơn: CUSTOMER xác thực và đúng chủ đơn.
  UC-10: khách hủy khi hợp lệ; BARISTA chỉ cập nhật tiến độ pha chế.
  UC-08: idempotency, amount server, loyalty EARN một lần sau success.
endlegend
@enduml
