@startuml
!pragma layout smetana
left to right direction
title BrewLite A2 - Use Case tổng thể
skinparam defaultFontName Arial
skinparam shadowing false
actor "Khách hàng" as Customer
actor "Nhân viên quầy" as Staff
actor "VNPay" as Gateway
rectangle "BrewLite" {
  usecase "UC-01 Đăng ký" as UC01
  usecase "UC-02 Đăng nhập" as UC02
  usecase "UC-03 Xem menu" as UC03
  usecase "UC-04 Xem chi tiết và tùy chọn món" as UC04
  usecase "UC-05 Quản lý giỏ hàng" as UC05
  usecase "UC-06 Tạo đơn" as UC06
  usecase "UC-07 Áp dụng coupon" as UC07
  usecase "UC-08 Thực hiện thanh toán" as UC08
  usecase "UC-09 Xem xác nhận và lịch sử" as UC09
  usecase "UC-10 Cập nhật trạng thái đơn" as UC10
  usecase "UC-11 Xem và đổi điểm lấy voucher" as UC11
  usecase "UC-12 Xem công thức món" as UC12
  usecase "UC-13 Quản lý tồn nguyên liệu" as UC13
}
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC09
Customer -- UC11
Staff -- UC02
Staff -- UC10
Staff -- UC12
Staff -- UC13
Gateway -- UC08
UC04 ..> UC03 : <<extend>>
UC07 ..> UC06 : <<extend>>
@enduml
