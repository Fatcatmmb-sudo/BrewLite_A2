
@startuml
title Usecase tổng thể dự án

left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle stickman

actor "Khách hàng" as Customer
actor "Nhân viên quầy" as Staff
actor "Mock Payment Gateway" as Payment

rectangle "HỆ THỐNG BREWLITE" {

    usecase "UC-01: Đăng ký" as UC01
    usecase "UC-02: Đăng nhập" as UC02
    usecase "UC-03: Xem menu" as UC03
    usecase "UC-04: Xem chi tiết sản phẩm\n+ size + topping" as UC04
    usecase "UC-05: Quản lý giỏ hàng" as UC05
    usecase "UC-06: Đặt hàng" as UC06
    usecase "UC-07: Áp dụng coupon" as UC07
    usecase "UC-08: Thực hiện thanh toán" as UC08
    usecase "UC-09: Xem xác nhận\nvà lịch sử đơn hàng" as UC09
    usecase "UC-10: Cập nhật trạng thái đơn hàng" as UC10
}

' Khách hàng
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC09

' Nhân viên quầy
Staff -- UC02
Staff -- UC10

' Cổng thanh toán giả lập
Payment -- UC08

' Quan hệ mở rộng
UC04 ..> UC03 : <<extend>>
UC07 ..> UC06 : <<extend>>

@enduml
