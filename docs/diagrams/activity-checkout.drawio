INSERT InventoryReservation (ACTIVE) + ReservationItem snapshot
INSERT CouponRedemption (RESERVED), History &amp; COMMIT (201)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FCF0DF;strokeColor=#222222;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="795" y="1067" width="390" height="86" as="geometry"/>
