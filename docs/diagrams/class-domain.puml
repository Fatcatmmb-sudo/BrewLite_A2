@startuml
!pragma layout smetana
title BrewLite A2 - Class Diagram domain
hide circle
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 19
skinparam ranksep 25
skinparam packageStyle rectangle

package "Danh mục và kho" {
  class Product {
    name: String
    isActive: Boolean
  }
  class ProductVariant {
    size: ProductSize
    price: BigInt
  }
  class RecipeItem {
    quantity: Int
  }
  class Ingredient {
    stockQuantity: Int
    version: Int
  }
  class InventoryReservation {
    quantity: Int
    status: ReservationStatus
    expiresAt: DateTime
  }
}

package "Đơn hàng và ưu đãi" {
  class User {
    username: String
    role: UserRole
    loyaltyBalance: Int
  }
  class Order {
    status: OrderStatus
    total: BigInt
    reservationExpiresAt: DateTime
  }
  class OrderItem {
    quantity: Int
    unitPrice: BigInt
  }
  class "Coupon (Promotion)" as Coupon {
    code: String
    discountValue: BigInt
  }
  class CouponRedemption {
    status: CouponRedemptionStatus
    discountAmount: BigInt
  }
  class LoyaltyTransaction {
    type: LoyaltyTransactionType
    points: Int
    balanceAfter: Int
  }
}

package "Thanh toán và đối soát" {
  class Payment {
    method: PaymentMethod
    status: PaymentStatus
    amount: BigInt
    idempotencyKey: String
    gatewayReference: String?
    paymentUrl: String?
  }
  class PaymentRecoveryRequest {
    status: PaymentRecoveryRequestStatus
    incidentReference: String
  }
  class PaymentRecoveryAudit {
    actorType: PaymentRecoveryActorType
    beforeState: PaymentStatus
    afterState: PaymentStatus
  }
  class PaymentRecoveryResolution {
    decision: PaymentRecoveryDecision
    evidenceReference: String
  }
}

Product "1" -- "0..*" ProductVariant
ProductVariant "1" -- "0..*" RecipeItem
Ingredient "1" -- "0..*" RecipeItem
ProductVariant "1" -- "0..*" OrderItem
ProductVariant "1" -- "0..*" InventoryReservation
User "1" -- "0..*" Order
Order "1" -- "0..*" OrderItem
Order "1" -- "0..*" InventoryReservation
Order "1" -- "0..*" Payment
Coupon "1" -- "0..*" CouponRedemption
Order "1" -- "0..1" CouponRedemption
User "1" -- "0..*" CouponRedemption
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction
Payment "1" -- "0..*" PaymentRecoveryRequest
Payment "1" -- "0..*" PaymentRecoveryAudit
Payment "1" -- "0..*" PaymentRecoveryResolution
PaymentRecoveryRequest "0..1" -- "0..*" PaymentRecoveryAudit

legend bottom
  |= Enum |= Giá trị |
  | UserRole | CUSTOMER, BARISTA, PAYMENT_OPERATOR |
  | OrderStatus | PENDING, PAYMENT_FAILED, PAID, PREPARING, READY, COMPLETED, CANCELLED |
  | PaymentMethod | E_WALLET, CARD, VNPAY |
  | PaymentStatus | PROCESSING, SUCCEEDED, FAILED, MANUAL_REVIEW, REFUNDED |
  | ReservationStatus | ACTIVE, CONSUMED, RELEASED, EXPIRED |
  | CouponRedemptionStatus | RESERVED, CONSUMED, RELEASED, EXPIRED |
  | LoyaltyTransactionType | EARN, REDEEM, ADJUSTMENT, REVERSAL |
  Các bảng hỗ trợ, quan hệ actor đối soát và enum đầy đủ nằm ở ERD PostgreSQL.
endlegend
@enduml
