@startuml
!pragma layout smetana
title BrewLite - Domain model A2 (MVP, không phải schema đã triển khai)
hide circle
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45

class User {
  id: UUID
  username: String {unique}
  passwordHash: String
  role: UserRole
  loyaltyBalance: Integer
  isActive: Boolean
}
class Product {
  id: UUID
  name: String
  description: String
  imageUrl: String?
  isActive: Boolean
}
class ProductVariant {
  id: UUID
  size: String
  price: VND Integer
  stock: Integer >= 0
  version: Integer
  isActive: Boolean
}
class Topping {
  id: UUID
  name: String
  price: VND Integer
  isActive: Boolean
}
class ProductTopping {
  productId: UUID
  toppingId: UUID
}
class Order {
  id: UUID
  orderNumber: String {unique}
  status: OrderStatus
  subtotal: VND Integer
  discountAmount: VND Integer
  total: VND Integer
  couponCodeSnapshot: String?
  reservationExpiresAt: UTC Timestamp
  createdAt: UTC Timestamp
  transition(nextStatus)
}
class OrderItem {
  id: UUID
  productNameSnapshot: String
  sizeSnapshot: String
  variantPriceSnapshot: VND Integer
  unitPrice: VND Integer
  quantity: Integer [1..20]
  sugarLevel: Integer? [0..100]
  iceLevel: Integer? [0..100]
  note: String? [max 500]
  lineTotal: VND Integer
}
class OrderItemTopping {
  id: UUID
  nameSnapshot: String
  priceSnapshot: VND Integer
}
class InventoryReservation {
  id: UUID
  quantity: Integer > 0
  status: ReservationStatus
  expiresAt: UTC Timestamp
  consume()
  release()
}
class OrderStatusHistory {
  id: UUID
  fromStatus: OrderStatus?
  toStatus: OrderStatus
  changedAt: UTC Timestamp
  reason: String?
}
class Payment {
  id: UUID
  idempotencyKey: String {unique}
  requestHash: String
  method: PaymentMethod
  status: PaymentStatus
  amount: VND Integer
  gatewayReference: String?
  createdAt: UTC Timestamp
}
class Promotion {
  id: UUID
  code: String {unique}
  discountType: DiscountType
  discountValue: Integer
  maxDiscount: VND Integer?
  minSubtotal: VND Integer
  totalUsageLimit: Integer?
  perUserLimit: Integer?
  startsAt: UTC Timestamp
  endsAt: UTC Timestamp
  isActive: Boolean
}
class PromotionRedemption {
  id: UUID
  status: RedemptionStatus
  discountAmount: VND Integer
  expiresAt: UTC Timestamp
}
class LoyaltyTransaction {
  id: UUID
  type: LoyaltyType
  points: Integer
  balanceAfter: Integer
  createdAt: UTC Timestamp
}

User "1" -- "0..*" Order : chủ đơn
Product "1" -- "0..*" ProductVariant : biến thể
Product "1" -- "0..*" ProductTopping
Topping "1" -- "0..*" ProductTopping : tùy chọn được phép
Order "1" *-- "1..20" OrderItem : snapshot món
ProductVariant "1" -- "0..*" OrderItem : nguồn catalog
OrderItem "1" *-- "0..*" OrderItemTopping : snapshot topping
Topping "1" -- "0..*" OrderItemTopping : nguồn catalog
Order "1" -- "1..*" InventoryReservation
ProductVariant "1" -- "0..*" InventoryReservation
Order "1" *-- "1..*" OrderStatusHistory
User "0..1" -right- "0..*" OrderStatusHistory : actor (null = hệ thống)
Order "1" -- "0..*" Payment : các lần thử
Order "1" -- "0..1" PromotionRedemption
Promotion "1" -- "0..*" PromotionRedemption
Promotion "0..*" -- "0..*" Product : phạm vi sản phẩm
Order "1" -- "0..1" LoyaltyTransaction

enum UserRole {
  CUSTOMER
  BARISTA
}
enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}
enum PaymentMethod {
  E_WALLET
  CARD
}
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}
enum RedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}
enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}
enum LoyaltyType {
  EARN
}
User ..> UserRole
Order ..> OrderStatus
Payment ..> PaymentStatus
Payment ..> PaymentMethod
InventoryReservation ..> ReservationStatus
PromotionRedemption ..> RedemptionStatus
Promotion ..> DiscountType
LoyaltyTransaction ..> LoyaltyType

legend bottom
  Cardinality là invariant nghiệp vụ khi order đã commit; không là schema ORM hiện có.
  Tiền nguyên VND, timestamp UTC. Promotion biểu diễn coupon trong MVP.
  Payment: nhiều attempt, tối đa một SUCCEEDED và một PROCESSING/order.
  Một reservation/order/variant; giữ tồn giảm stock, consume không giảm lần hai.
  Expiry/hủy: RELEASED + lý do history, hoàn tồn/coupon một lần.
  Một EARN/order; không có đổi điểm/refund trong MVP. Snapshot không đổi theo catalog.
endlegend
@enduml
