# Proposed local configuration only; env loading is not implemented.
# Replace placeholders. Never use these values in production.
NODE_ENV=development

# API process port; Next.js will use 3000 once implemented.
PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:3000

# Host URL. Containers require the DB service hostname chosen in #36.
DATABASE_URL=postgresql://brewlite:REPLACE_LOCAL_PASSWORD@localhost:5432/brewlite?schema=public

# Server only; generate a strong random secret outside Git before running.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ISSUER=brewlite-api
JWT_AUDIENCE=brewlite-web
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# Mock only; no real card data or live provider keys.
PAYMENT_PROVIDER=mock
# Sample TTL/timeouts for review, not approved business requirements.
RESERVATION_TTL_SECONDS=900
HEALTHCHECK_TIMEOUT_MS=2000
